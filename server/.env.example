# Copy to server/.env and fill in. server/.env is gitignored.
PORT=8787
# Speech: live transcription while the ring is held.
DEEPGRAM_API_KEY=
# Fallback for words the parser cannot use. Leave empty to run parser only.
ANTHROPIC_API_KEY=
# Optional: ONHAND_MODEL=claude-opus-5-5
# Google Sheet bridge: the web app URL from apps-script/Code.gs, and the same
# random token you set as the ONHAND_TOKEN script property.
SHEET_SCRIPT_URL=
SHEET_SCRIPT_TOKEN=
# Optional tab mapping, tab=schema: SHEET_TABS=Units=dubai-units,Menu=restaurant-menu,Cars=car-stock
